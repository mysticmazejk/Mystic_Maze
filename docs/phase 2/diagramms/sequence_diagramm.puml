
@startuml

actor Spieler

participant "Browser" as Browser
participant "WebSocket-\nHandler" as WS
participant "GameManager" as Manager
participant "Game" as Game
participant "Board" as Board
participant "ConnectionManager" as Connections
participant "Weitere Browser" as Others

== Freie Kachel drehen ==

opt Spieler dreht die freie Kachel
    Spieler -> Browser : freie Kachel drehen
    Browser -> WS : rotate_spare_tile

    WS -> Manager : rotate_spare_tile(game_id,\nplayer_index)
    Manager -> Game : rotate_spare_tile()
    Game --> Manager
    Manager --> WS

    WS -> Connections : Spielzustand verteilen
    Connections --> Browser : game_state und player_state
    Connections --> Others : game_state und jeweiliger player_state
    WS --> Browser : action_success
end

== Labyrinth verschieben ==

Spieler -> Browser : Einschubposition wählen
Browser -> WS : shift(index, direction)

WS -> Manager : shift_board(game_id,\nplayer_index, index, direction)
Manager -> Game : insert_spare_tile(index, direction)

Game -> Game : Spielstatus und\nZugberechtigung prüfen

alt Aktion gültig
    Game -> Board : insert_spare_tile(index, direction)
    Board --> Game : Spielfeld verschoben

    Game -> Game : betroffene Spieler mitverschieben

    Game --> Manager
    Manager --> WS

    WS -> Connections : Spielzustand verteilen
    Connections --> Browser : game_state und player_state
    Connections --> Others : game_state und jeweiliger player_state
    WS --> Browser : action_success

else Aktion ungültig
    Game --> Manager : Fehler
    Manager --> WS : Fehler
    WS --> Browser : error
end

== Spielfigur bewegen ==

opt Spieler bewegt seine Spielfigur
    Spieler -> Browser : Zielfeld auswählen
    Browser -> WS : move(row, column)

    WS -> Manager : move_player(game_id,\nplayer_index, row, column)
    Manager -> Game : move_player(player, row, column)

    Game -> Board : get_reachable_positions(...)
    Board --> Game : erreichbare Positionen

    alt Zielfeld erreichbar
        Game -> Game : Spielerposition aktualisieren
        Game -> Game : Kacheleffekte verarbeiten
        Game -> Game : Siegbedingung prüfen

        Game --> Manager
        Manager --> WS

        WS -> Connections : Spielzustand verteilen
        Connections --> Browser : game_state und player_state
        Connections --> Others : game_state und jeweiliger player_state
        WS --> Browser : action_success

    else Zielfeld nicht erreichbar
        Game --> Manager : Fehler
        Manager --> WS : Fehler
        WS --> Browser : error
    end
end

== Zug beenden ==

opt Partie nicht beendet
    Spieler -> Browser : Zug beenden
    Browser -> WS : end_turn

    WS -> Manager : end_turn(game_id, player_index)
    Manager -> Game : end_turn()

    Game -> Game : nächsten Spieler aktivieren\nund Zugstatus zurücksetzen

    Game --> Manager
    Manager --> WS

    WS -> Connections : Spielzustand verteilen
    Connections --> Browser : game_state und player_state
    Connections --> Others : game_state und jeweiliger player_state
    WS --> Browser : action_success
end

@enduml
